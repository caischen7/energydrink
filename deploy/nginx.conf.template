# Rendered by the nginx image's envsubst entrypoint at startup; ${PORT} is
# replaced with the Cloud Run port (default 8080). nginx runtime variables like
# $uri are left untouched (they are not environment variables).
server {
    listen       ${PORT} default_server;
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    gzip            on;
    gzip_comp_level 5;
    gzip_min_length 256;
    gzip_types      text/css application/javascript application/json image/svg+xml;

    # Content-hashed build assets — safe to cache hard.
    location /assets/ {
        expires    1y;
        add_header Cache-Control "public, immutable";
    }

    # The pre-aggregated dashboard feed — short cache, it changes between builds.
    location = /market_intel.json {
        add_header Cache-Control "public, max-age=300";
    }

    # Real files exist for / (index.html) and /dashboard.html; otherwise 404.
    location / {
        try_files $uri $uri/ =404;
    }
}

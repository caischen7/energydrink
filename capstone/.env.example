# Reddit Data API credentials — copy this file to capstone/.env and fill it in.
# capstone/.env is gitignored and will never be committed.
#
# Get these by creating a **script** app at https://www.reddit.com/prefs/apps
#   - client id  = the string shown UNDER the app name (not labelled)
#   - secret     = the field labelled "secret"
#   - redirect uri can be http://localhost:8080 (unused by this flow)

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Reddit requires a descriptive User-Agent and throttles generic ones harder.
# Put your actual Reddit username in place of <you>.
REDDIT_USER_AGENT=script:bogus-banana-capstone:v1 (by /u/<you>)
